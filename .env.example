# Copy to .env. Only needed for LLM=anthropic or LLM=ollama; the scripted model needs nothing.
# Use a separate key with a spend limit. Payloads and fake data are sent to the provider.
ANTHROPIC_API_KEY=
# Model id. Empty uses the backend's default (claude-opus-5-5, or qwen3:8b for ollama). claude-haiku-5-5 is cheaper.
LLM_MODEL=
# Ollama server as seen from the containers.
OLLAMA_URL=http://host.docker.internal:11434
